{
  "manifest_version": 3,
  "name": "Wrote",
  "version": "1.0.1",
  "description": "Save page impressions from Chrome to Notion.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://api.notion.com/*"],
  "action": {
    "default_title": "Wrote",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
